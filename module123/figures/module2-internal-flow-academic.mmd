%%{init: {"theme": "base", "themeVariables": {"background": "#FFFFFF", "primaryColor": "#F8FAFC", "primaryTextColor": "#0F172A", "primaryBorderColor": "#334155", "lineColor": "#475569", "fontFamily": "Arial, Helvetica, sans-serif"}}}%%
flowchart LR
    A["论文 JSON<br/>papers/*.json"] --> B["元数据读取<br/>标题、作者、摘要、链接"]
    B --> C["信息补全<br/>arXiv ID / 摘要 / PDF 链接"]
    C --> D["论文上下文构建"]

    D --> E["PDF 内容增强<br/>可选"]
    E --> E1["正文文本提取<br/>长度截断控制"]
    E --> E2["Figure / Table 定位<br/>裁剪渲染为 PNG"]
    E1 --> F
    E2 --> F
    D --> F["提示词构造<br/>元数据 + 摘要 + 正文 + 图表"]

    F --> G["大模型生成<br/>结构化 JSON"]
    G --> H["JSON 解析<br/>标题、导语、小节、图注"]
    H --> I["Markdown 组装<br/>公众号风格正文"]
    I --> J["YAML 元数据写入<br/>wechat_title / inline_images 等"]
    J --> K["Markdown 输出<br/>summaries/*.md"]
    K --> L["索引维护<br/>summarized.json / index.md"]

    classDef input fill:#EEF2FF,stroke:#3730A3,stroke-width:1.5px,color:#111827;
    classDef preprocess fill:#F8FAFC,stroke:#334155,stroke-width:1.2px,color:#0F172A;
    classDef enhance fill:#ECFEFF,stroke:#0891B2,stroke-width:1.3px,color:#164E63;
    classDef model fill:#ECFDF5,stroke:#047857,stroke-width:1.5px,color:#064E3B;
    classDef output fill:#FDF2F8,stroke:#BE185D,stroke-width:1.5px,color:#831843;

    class A input;
    class B,C,D,H,I,J preprocess;
    class E,E1,E2 enhance;
    class F,G model;
    class K,L output;
